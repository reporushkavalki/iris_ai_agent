{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris",
  "mainBinaryName": "Iris",
  "version": "1.0.0",
  "identifier": "app.iris.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Iris contributors",
    "shortDescription": "Your crypto control room. Runs only on your computer.",
    "copyright": "MIT license",
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "server/iris-server/**/*": "iris-server/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English"] }
    }
  }
}
